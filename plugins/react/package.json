{
  "name": "visual-editor-react",
  "displayName": "Visual Editor: React",
  "description": "Shows React apps in Visual Editor: components and their props, pages, and API calls.",
  "version": "0.1.0",
  "publisher": "arka102202",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "arka102202.visual-editor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "visualEditor.react.setDevToken",
        "title": "Set Dev Login Token for Previews",
        "category": "Visual Editor"
      },
      {
        "command": "visualEditor.react.forgetLive",
        "title": "Forget Recorded Replies and Token",
        "category": "Visual Editor"
      }
    ]
  }
}
