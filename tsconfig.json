{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vscode"],
    "paths": {
      "@visual-editor/contract": ["./packages/contract/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "plugins/*/src", "plugins/*/test", "test-vscode"]
}
