{
  "name": "visual-editor",
  "displayName": "Visual Editor",
  "description": "See your project as maps, review every change, and grow the editor with plugins for your stack.",
  "version": "0.1.0",
  "publisher": "arka102202",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Visual Editor",
      "properties": {
        "visualEditor.agents.runIn": {
          "type": "string",
          "enum": [
            "background",
            "terminal"
          ],
          "enumDescriptions": [
            "Quietly, with a progress line and Stop; a notice when it's done.",
            "In a terminal tab, where you watch it and can talk to it."
          ],
          "default": "background",
          "description": "Where an agent runs when you start it with the Run an agent command."
        },
        "visualEditor.agents.maxCostUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Only if you pay Claude per use (an API key): the most an agent run in the background may spend, in US dollars, before it stops. 0: no limit. With a Claude subscription, runs use your plan's allowance like chat does; they're always limited to 3 rounds and 20 minutes, and you can stop them."
        },
        "visualEditor.claude.reviewOnly": {
          "type": "boolean",
          "default": true,
          "description": "Claude Code changes a connected project's files only through Visual Editor, so every change reaches Review with its checks. Its own file tools and shell commands that write into the project are stopped (set in the folder's .claude/settings.local.json). Turn off to let it edit files directly."
        },
        "visualEditor.tester.model": {
          "type": "string",
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ],
          "default": "haiku",
          "description": "The model of the tester: the Claude that tries a scenario in the app like a person, when the quick automatic run and the reading of the code disagree. Each one it tries is a few turns with pictures, on your plan."
        },
        "visualEditor.logicCheck.model": {
          "type": "string",
          "enum": [
            "sonnet",
            "opus"
          ],
          "enumDescriptions": [
            "Lighter on your plan's allowance; good for everyday changes.",
            "The most thorough; uses more of your allowance."
          ],
          "default": "sonnet",
          "description": "Which Claude model runs the logic check that every change passes before it reaches Review."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visualEditor",
          "title": "Visual Editor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "visualEditor": [
        {
          "id": "visualEditor.projects",
          "name": "Projects",
          "initialSize": 2
        },
        {
          "id": "visualEditor.assistants",
          "name": "Assistants",
          "initialSize": 1
        },
        {
          "type": "webview",
          "id": "visualEditor.agents",
          "name": "Agents",
          "initialSize": 4
        },
        {
          "id": "visualEditor.memory",
          "name": "Memory",
          "initialSize": 3
        },
        {
          "id": "visualEditor.plugins",
          "name": "Plugins",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "visualEditor.openMap",
        "title": "Open the Map",
        "category": "Visual Editor",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "visualEditor.openWebview",
        "title": "Open the Webview (the running app)",
        "category": "Visual Editor",
        "icon": "$(preview)"
      },
      {
        "command": "visualEditor.openApp",
        "title": "Open the App through Visual Editor",
        "category": "Visual Editor",
        "icon": "$(globe)"
      },
      {
        "command": "visualEditor.openReview",
        "title": "Open Review",
        "category": "Visual Editor",
        "icon": "$(checklist)"
      },
      {
        "command": "visualEditor.tryProposal",
        "title": "Try Review with an Example Proposal",
        "category": "Visual Editor"
      },
      {
        "command": "visualEditor.chooseProject",
        "title": "Choose Project",
        "category": "Visual Editor",
        "icon": "$(folder-library)"
      },
      {
        "command": "visualEditor.showPlugins",
        "title": "Show Plugins",
        "category": "Visual Editor"
      },
      {
        "command": "visualEditor.addRule",
        "title": "Add a Rule",
        "category": "Visual Editor",
        "icon": "$(law)"
      },
      {
        "command": "visualEditor.addDecision",
        "title": "Add a Decision",
        "category": "Visual Editor",
        "icon": "$(milestone)"
      },
      {
        "command": "visualEditor.editMemory",
        "title": "Edit",
        "category": "Visual Editor",
        "icon": "$(edit)"
      },
      {
        "command": "visualEditor.removeMemory",
        "title": "Forget",
        "category": "Visual Editor",
        "icon": "$(trash)"
      },
      {
        "command": "visualEditor.connectClaudeCode",
        "title": "Connect Claude Code",
        "category": "Visual Editor",
        "icon": "$(plug)"
      },
      {
        "command": "visualEditor.chooseAssistant",
        "title": "Assistants",
        "category": "Visual Editor",
        "icon": "$(plug)"
      },
      {
        "command": "visualEditor.connectAssistant",
        "title": "Connect",
        "category": "Visual Editor",
        "icon": "$(plug)"
      },
      {
        "command": "visualEditor.disconnectAssistant",
        "title": "Disconnect",
        "category": "Visual Editor",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "visualEditor.reviewOnlyOff",
        "title": "Changes only through Review (on): let Claude edit files directly",
        "category": "Visual Editor",
        "icon": "$(lock)"
      },
      {
        "command": "visualEditor.reviewOnlyOn",
        "title": "Claude edits files directly: make it change files only through Review",
        "category": "Visual Editor",
        "icon": "$(unlock)"
      },
      {
        "command": "visualEditor.openAgents",
        "title": "Open the Agents as a tab",
        "category": "Visual Editor",
        "icon": "$(screen-full)"
      },
      {
        "command": "visualEditor.runAgent",
        "title": "Run an agent",
        "category": "Visual Editor",
        "icon": "$(play)"
      },
      {
        "command": "visualEditor.stopJob",
        "title": "Stop the agent",
        "category": "Visual Editor",
        "icon": "$(debug-stop)"
      },
      {
        "command": "visualEditor.addAgents",
        "title": "Add Visual Editor's agents to Claude Code",
        "category": "Visual Editor",
        "icon": "$(hubot)"
      },
      {
        "command": "visualEditor.startSession",
        "title": "Start a design session",
        "category": "Visual Editor",
        "icon": "$(paintcan)"
      },
      {
        "command": "visualEditor.openSession",
        "title": "Open a design session",
        "category": "Visual Editor",
        "icon": "$(window)"
      },
      {
        "command": "visualEditor.showClosedHints",
        "title": "Show closed hints again",
        "category": "Visual Editor"
      },
      {
        "command": "visualEditor.deleteSession",
        "title": "Delete this session for good",
        "category": "Visual Editor",
        "icon": "$(close)"
      },
      {
        "command": "visualEditor.cleanUpSessions",
        "title": "Clean up sessions: suggest which to delete",
        "category": "Visual Editor",
        "icon": "$(sparkle)"
      },
      {
        "command": "visualEditor.deleteSuggestedSessions",
        "title": "See the sessions suggested to delete (delete one, or all)",
        "category": "Visual Editor",
        "icon": "$(trash)"
      },
      {
        "command": "visualEditor.clearSessionSuggestions",
        "title": "Clear the suggestions (keep them all)",
        "category": "Visual Editor",
        "icon": "$(clear-all)"
      },
      {
        "command": "visualEditor.showOlderSessions",
        "title": "Show older sessions",
        "category": "Visual Editor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visualEditor.openMap",
          "when": "view == visualEditor.projects",
          "group": "navigation@1"
        },
        {
          "command": "visualEditor.openReview",
          "when": "view == visualEditor.projects",
          "group": "navigation@2"
        },
        {
          "command": "visualEditor.chooseProject",
          "when": "view == visualEditor.projects",
          "group": "navigation@3"
        },
        {
          "command": "visualEditor.addRule",
          "when": "view == visualEditor.memory",
          "group": "navigation@1"
        },
        {
          "command": "visualEditor.addDecision",
          "when": "view == visualEditor.memory",
          "group": "navigation@2"
        },
        {
          "command": "visualEditor.openAgents",
          "when": "view == visualEditor.agents",
          "group": "navigation"
        },
        {
          "command": "visualEditor.startSession",
          "when": "view == visualEditor.agents",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "visualEditor.addRule",
          "when": "view == visualEditor.memory && viewItem == group-rule",
          "group": "inline"
        },
        {
          "command": "visualEditor.addDecision",
          "when": "view == visualEditor.memory && viewItem == group-decision",
          "group": "inline"
        },
        {
          "command": "visualEditor.editMemory",
          "when": "view == visualEditor.memory && viewItem =~ /^entry-(rule|decision|note)$/",
          "group": "inline@1"
        },
        {
          "command": "visualEditor.removeMemory",
          "when": "view == visualEditor.memory && viewItem =~ /^entry-/",
          "group": "inline@2"
        },
        {
          "command": "visualEditor.connectAssistant",
          "when": "view == visualEditor.assistants && viewItem == assistant-off",
          "group": "inline"
        },
        {
          "command": "visualEditor.addAgents",
          "when": "view == visualEditor.assistants && viewItem =~ /^assistant-on-noagents/",
          "group": "inline@1"
        },
        {
          "command": "visualEditor.reviewOnlyOff",
          "when": "view == visualEditor.assistants && viewItem =~ /-locked$/",
          "group": "inline@0"
        },
        {
          "command": "visualEditor.reviewOnlyOn",
          "when": "view == visualEditor.assistants && viewItem =~ /-open$/",
          "group": "inline@0"
        },
        {
          "command": "visualEditor.disconnectAssistant",
          "when": "view == visualEditor.assistants && viewItem =~ /^assistant-on/",
          "group": "inline@2"
        },
        {
          "command": "visualEditor.deleteSession",
          "when": "view == visualEditor.memory && viewItem =~ /^session(-suggested)?$/",
          "group": "inline"
        },
        {
          "command": "visualEditor.cleanUpSessions",
          "when": "view == visualEditor.memory && viewItem =~ /^sessions(-suggested)?$/",
          "group": "inline@0"
        },
        {
          "command": "visualEditor.deleteSuggestedSessions",
          "when": "view == visualEditor.memory && viewItem == sessions-suggested",
          "group": "inline@1"
        },
        {
          "command": "visualEditor.clearSessionSuggestions",
          "when": "view == visualEditor.memory && viewItem == sessions-suggested",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "visualEditor.editMemory",
          "when": "false"
        },
        {
          "command": "visualEditor.removeMemory",
          "when": "false"
        },
        {
          "command": "visualEditor.connectAssistant",
          "when": "false"
        },
        {
          "command": "visualEditor.disconnectAssistant",
          "when": "false"
        },
        {
          "command": "visualEditor.reviewOnlyOff",
          "when": "false"
        },
        {
          "command": "visualEditor.reviewOnlyOn",
          "when": "false"
        },
        {
          "command": "visualEditor.deleteSession",
          "when": "false"
        },
        {
          "command": "visualEditor.deleteSuggestedSessions",
          "when": "false"
        },
        {
          "command": "visualEditor.clearSessionSuggestions",
          "when": "false"
        },
        {
          "command": "visualEditor.showOlderSessions",
          "when": "false"
        }
      ]
    }
  }
}
